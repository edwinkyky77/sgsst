// appsettings.json
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=sgsst;Uid=root;Pwd=1234;AllowUserVariables=true;" // Agregado AllowUserVariables para futuras expansiones
  },
  "JwtSettings": {
    "Secret": "UnaClaveSecretaSuperLargaYComplejaParaJWTQueDebeSerDeAlMenos32Caracteres", // ¡¡CAMBIA ESTO!! Usa una clave única y segura.
    "Issuer": "SGSSTApi",
    "Audience": "SGSSTClient",
    "ExpirationInMinutes": 60 // El token expira en 60 minutos
  },
  "WhatsAppSettings": { // Nueva sección para WhatsApp
    "ApiUrl": "https://api.whatsapp.com/send", // URL de ejemplo, usarás la de tu proveedor
    "Token": "YOUR_WHATSAPP_API_TOKEN" // Reemplaza con tu token real
  },
  "EmailSettings": { // Nueva sección para Email
    "SmtpServer": "smtp.gmail.com", // Servidor SMTP (ej. para Gmail)
    "SmtpPort": 587,
    "SenderEmail": "edwinkyky@gmail.com", // Tu correo remitente
    "SenderPassword": "2017manizales2017", // Contraseña de aplicación (no tu contraseña de email normal)
    "SenderName": "Soporte SGSST"
  }
}